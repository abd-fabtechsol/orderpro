{
  "expo": {
    "name": "NAVARO",
    "slug": "orderpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1DBF72"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to take profile pictures and product photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select profile pictures and product photos.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "orderpro-env-1.eba-jn6vrmvc.us-east-2.elasticbeanstalk.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "bundleIdentifier": "com.abd.navaro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1DBF72"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.abd.navaro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photo library to select profile pictures and product photos.",
          "cameraPermission": "This app needs access to camera to take profile pictures and product photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "28258ca2-0e2a-4ec7-b141-d428015e0d29"
      }
    },
    "owner": "abdulrehman030",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/28258ca2-0e2a-4ec7-b141-d428015e0d29"
    }
  }
}
